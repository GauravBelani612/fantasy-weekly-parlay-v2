# ---- Database ----
# Local dev (default): SQLite, no infrastructure needed.
DATABASE_URL=sqlite+aiosqlite:///./parlay.db
# Production (Neon): note the +asyncpg driver and sslmode stripped from the query string.
# DATABASE_URL=postgresql+asyncpg://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb

# ---- Session ----
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=dev-insecure-secret-change-me
SESSION_TTL_DAYS=30

# ---- Google Sign-In ----
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client ID (Web).
# Authorized JavaScript origins must include your frontend URL.
GOOGLE_CLIENT_ID=

# ---- CORS / cookies ----
# Comma-separated list of allowed frontend origins.
FRONTEND_ORIGIN=http://localhost:5173
# Base URL used for links inside emails. Defaults to the first FRONTEND_ORIGIN.
APP_URL=http://localhost:5173
# Set both of these in production (frontend on Vercel, API on Render = cross-site cookie).
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# ---- Scheduled notifications ----
# Shared secret for POST /internal/tick. Never expose to the browser.
INTERNAL_TICK_SECRET=dev-tick-secret

# ---- Email (Phase 4) ----
RESEND_API_KEY=
EMAIL_FROM=Parlay <onboarding@resend.dev>
